# Supabase project URL. Required for auth, profiles, saved calculations, admin pages, and /mpstats access gate.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable browser key. Required with NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application URL used in approval emails. Required for production email links; optional for local dev.
NEXT_PUBLIC_APP_URL=

# Server-only fallback application URL used by email rendering if NEXT_PUBLIC_APP_URL is not set.
APP_BASE_URL=

# Supabase service role key. Server-only. Required for the protected WB tariff cron refresh.
SUPABASE_SERVICE_ROLE_KEY=

# Long random secret for the protected /api/cron/wb-tariffs route in production.
CRON_SECRET=

# Wildberries API token. Server-only. Required for WB tariff import and cron refresh.
WB_API_TOKEN=

# Legacy Wildberries API token alias. Optional; prefer WB_API_TOKEN for new setups.
WILDBERRIES_API_TOKEN=

# Optional import date override for scripts/import_wb_tariffs.mjs, format YYYY-MM-DD.
WB_TARIFF_DATE=

# Optional directory with cached WB tariff API JSON files for local imports.
WB_TARIFFS_CACHE_DIR=

# Server-only MPStats token. Required for /api/mpstats/* routes and CLI diagnostics.
MPSTATS_TOKEN=

# Optional MPStats API base URL override. Leave empty to use the built-in default.
MPSTATS_BASE_URL=

# Resend API key. Server-only. Required only if approval emails should be sent.
RESEND_API_KEY=

# Sender address for approval emails. Required together with RESEND_API_KEY.
APPROVAL_EMAIL_FROM=

# Optional host for the static preview server.
HOST=

# Optional port for the static preview server.
PORT=
